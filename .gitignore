# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# wasmify build outputs (host miniperl, wasm, wasm2go bundle)
build/

# wasmify working dir: captured build log, deployed posix-compat / host stub
# headers, wasm-build state. All regenerated by `wasmify build` / `wasm-build`.
.wasmify/

# wasmify-generated artefacts, regenerated by `make wasm` from wasmify.json +
# the perl5 submodule + the committed bridge inputs (perl.cc, pl.h). They are
# build outputs, not source — never commit them (a captured build.json also
# embeds host-absolute paths, so it does not replay on another machine).
/build.json
/api-spec.json
/proto/perl.proto
/bridge/
/*.wasm

# Generated stdlib zip (built from the assembled perl5/lib by
# scripts/make-stdlib-zip.py during release staging; published as a release
# asset, not committed).
/perl_stdlib.zip
